<Window x:Class="DemkaIva.SignUpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Запись на услугу"
        Height="420" Width="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Icon="Images/beauty_logo.ico">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#E1E4FF" Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Image Source="Images/beauty_logo.png"
                       Height="35" Stretch="Uniform" Margin="0,0,10,0"/>
                <TextBlock x:Name="TxtHeader"
                           Grid.Column="1"
                           Text="Оформление записи"
                           FontSize="18" FontWeight="Bold"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="15">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="Услуга:" Grid.Row="0"
                       FontWeight="Bold" Margin="0,8"/>
            <TextBlock x:Name="TxtServiceTitle" Grid.Row="0" Grid.Column="1"
                       FontWeight="Bold" TextWrapping="Wrap" Margin="0,8"/>

            <TextBlock Text="Длительность:" Grid.Row="1" Margin="0,8"/>
            <TextBlock x:Name="TxtDuration" Grid.Row="1" Grid.Column="1" Margin="0,8"/>

            <TextBlock Text="Клиент:" Grid.Row="2"
                       Margin="0,8" VerticalAlignment="Center"/>
            <ComboBox x:Name="CmbClients" Grid.Row="2" Grid.Column="1"
                      Margin="0,8" Height="26"/>

            <TextBlock Text="Дата:" Grid.Row="3"
                       Margin="0,8" VerticalAlignment="Center"/>
            <DatePicker x:Name="DpDate" Grid.Row="3" Grid.Column="1"
                        Width="150" Height="26" HorizontalAlignment="Left"
                        Margin="0,8"
                        SelectedDateChanged="DpDate_SelectedDateChanged"/>

            <TextBlock Text="Время начала (ЧЧ:ММ):" Grid.Row="4"
                       Margin="0,8" VerticalAlignment="Center"/>
            <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" Margin="0,8">
                <TextBox x:Name="TxtTime" Width="70" Height="26"
                         HorizontalContentAlignment="Center"
                         VerticalContentAlignment="Center"
                         TextChanged="TxtTime_TextChanged"
                         PreviewTextInput="TxtTime_PreviewTextInput"
                         MaxLength="5"/>
                <TextBlock Text="  Окончание:  " VerticalAlignment="Center"/>
                <TextBlock x:Name="TxtEndTime" VerticalAlignment="Center"
                           FontWeight="Bold"/>
            </StackPanel>

            <Button Content="Подтвердить запись"
                    Grid.Row="5" Grid.ColumnSpan="2"
                    Height="38" VerticalAlignment="Bottom"
                    Margin="0,20,0,0"
                    Click="BtnSave_Click"/>
        </Grid>
    </Grid>
</Window>