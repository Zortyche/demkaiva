<Window x:Class="DemkaIva.AppointmentsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ближайшие записи"
        Height="550" Width="1050"
        MinHeight="400" MinWidth="800"
        WindowStartupLocation="CenterScreen"
        Icon="Images/beauty_logo.ico">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#E1E4FF" Padding="10">
            <StackPanel Orientation="Horizontal">
                <Image Source="Images/beauty_logo.png"
                       Height="35" Margin="0,0,10,0"/>
                <TextBlock Text="Ближайшие записи на сегодня и завтра"
                           FontSize="18" FontWeight="Bold"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <ListView x:Name="LvAppointments" Grid.Row="1" Margin="10"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Услуга" Width="200"
                                    DisplayMemberBinding="{Binding ServiceTitle}"/>
                    <GridViewColumn Header="Клиент" Width="200"
                                    DisplayMemberBinding="{Binding ClientName}"/>
                    <GridViewColumn Header="Email" Width="160"
                                    DisplayMemberBinding="{Binding Email}"/>
                    <GridViewColumn Header="Телефон" Width="140"
                                    DisplayMemberBinding="{Binding Phone}"/>
                    <GridViewColumn Header="Дата и время" Width="130"
                                    DisplayMemberBinding="{Binding StartTime, StringFormat='{}{0:dd.MM.yyyy HH:mm}'}"/>
                    <GridViewColumn Header="Осталось" Width="160">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding RemainingText}"
                                           Foreground="{Binding RemainingBrush}"
                                           FontWeight="Bold"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>

        <StackPanel Grid.Row="2" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="10">
            <Button Content="Редактировать" Click="BtnEdit_Click"
                    Width="130" Margin="0,0,10,0"/>
            <Button Content="Удалить" Click="BtnDelete_Click"
                    Width="110" Margin="0,0,10,0" Background="DarkGray"/>
            <Button Content="Обновить" Click="BtnRefresh_Click"
                    Width="110" Margin="0,0,10,0"/>
            <Button Content="Закрыть" Click="BtnClose_Click"
                    Width="110"/>
        </StackPanel>
    </Grid>
</Window>