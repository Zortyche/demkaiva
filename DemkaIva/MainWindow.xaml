<Window x:Class="DemkaIva.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Бархатные бровки — Управление услугами"
        Height="720" Width="1000"
        MinHeight="500" MinWidth="800"
        WindowStartupLocation="CenterScreen"
        Icon="Images/beauty_logo.ico">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Шапка -->
        <Border Grid.Row="0" Background="#E1E4FF" Padding="15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Image Source="Images/beauty_logo.png" Height="50" Stretch="Uniform" Margin="0,0,15,0"/>
                <TextBlock Grid.Column="1" Text="Список услуг"
                           FontSize="24" FontWeight="Bold"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Панель поиска / фильтра -->
        <WrapPanel Grid.Row="1" Margin="15,15,15,5">
            <StackPanel Margin="0,0,15,10">
                <TextBlock Text="Поиск:" Foreground="Gray" Margin="0,0,0,3"/>
                <TextBox x:Name="TxtSearch" Width="200" Height="25"
                         TextChanged="FilterChanged"/>
            </StackPanel>

            <StackPanel Margin="0,0,15,10">
                <TextBlock Text="Сортировка:" Foreground="Gray" Margin="0,0,0,3"/>
                <ComboBox x:Name="CmbSort" Width="180" Height="25"
                          SelectionChanged="FilterChanged">
                    <ComboBoxItem Content="Без сортировки" IsSelected="True"/>
                    <ComboBoxItem Content="По возрастанию цены"/>
                    <ComboBoxItem Content="По убыванию цены"/>
                </ComboBox>
            </StackPanel>

            <StackPanel Margin="0,0,15,10">
                <TextBlock Text="Скидка:" Foreground="Gray" Margin="0,0,0,3"/>
                <ComboBox x:Name="CmbFilter" Width="170" Height="25"
                          SelectionChanged="FilterChanged">
                    <ComboBoxItem Content="Все" IsSelected="True"/>
                    <ComboBoxItem Content="от 0% до 5%"/>
                    <ComboBoxItem Content="от 5% до 15%"/>
                    <ComboBoxItem Content="от 15% до 30%"/>
                    <ComboBoxItem Content="от 30% до 70%"/>
                    <ComboBoxItem Content="от 70% до 100%"/>
                </ComboBox>
            </StackPanel>

            <StackPanel Margin="15,0,0,10">
                <TextBlock Text="Код администратора:" Foreground="Gray" Margin="0,0,0,3"/>
                <PasswordBox x:Name="PbAdmin" Width="120" Height="25"
                             PasswordChanged="PbAdmin_PasswordChanged"/>
            </StackPanel>
        </WrapPanel>

        <!-- Список услуг -->
        <ListView x:Name="LvServices" Grid.Row="2" Margin="10,0"
                  BorderThickness="0"
                  HorizontalContentAlignment="Stretch"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="#CCCCCC" BorderThickness="1"
                            CornerRadius="4" Margin="5" Padding="10"
                            Background="{Binding CardBackground}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Image Grid.Column="0"
                                   Source="{Binding ImagePath}"
                                   Width="80" Height="80"
                                   Stretch="UniformToFill"/>

                            <StackPanel Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Margin="15,0">
                                <TextBlock Text="{Binding Title}"
                                           FontWeight="Bold"
                                           FontSize="16"
                                           TextWrapping="Wrap"/>
                                <StackPanel Orientation="Horizontal" Margin="0,5">
                                    <TextBlock Text="{Binding Cost, StringFormat='{}{0:N0} руб.'}"
                                               TextDecorations="Strikethrough"
                                               Foreground="Gray"
                                               Visibility="{Binding HasDiscountVisibility}"
                                               Margin="0,0,8,0"/>
                                    <TextBlock Text="{Binding DiscountedCost, StringFormat='{}{0:N0} руб.'}"
                                               FontWeight="Bold"
                                               FontSize="14"/>
                                    <TextBlock Text="{Binding DiscountText}"
                                               Foreground="#FF4A6D"
                                               FontWeight="Bold"
                                               Margin="10,0,0,0"
                                               Visibility="{Binding HasDiscountVisibility}"/>
                                </StackPanel>
                                <TextBlock Text="{Binding DurationInMinutes, StringFormat='за {0} минут'}"
                                           Foreground="#555555"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2"
                                        VerticalAlignment="Center"
                                        Width="170">
                                <Button Content="Записать клиента"
                                        Click="BtnSignUp_Click"
                                        Margin="0,3"
                                        Visibility="{Binding AdminVisibility, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                <Button Content="Редактировать"
                                        Click="BtnEdit_Click"
                                        Margin="0,3"
                                        Visibility="{Binding AdminVisibility, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                <Button Content="Удалить"
                                        Click="BtnDelete_Click"
                                        Margin="0,3"
                                        Background="DarkGray"
                                        Visibility="{Binding AdminVisibility, RelativeSource={RelativeSource AncestorType=Window}}"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- Нижняя панель -->
        <Grid Grid.Row="3" Margin="15">
            <TextBlock x:Name="TxtCount"
                       VerticalAlignment="Center"
                       FontSize="14" FontWeight="SemiBold"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BtnNearest"
                        Content="Ближайшие записи"
                        Click="BtnNearest_Click"
                        Margin="0,0,10,0"
                        Visibility="{Binding AdminVisibility, RelativeSource={RelativeSource AncestorType=Window}}"/>
                <Button x:Name="BtnAdd"
                        Content="Добавить услугу"
                        Click="BtnAdd_Click"
                        Visibility="{Binding AdminVisibility, RelativeSource={RelativeSource AncestorType=Window}}"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>